# Copy to .env and adjust. Never commit .env (the repo is public).

# API
PORT=3000
# Where the web app runs, for CORS and links in emails
WEB_ORIGIN=http://localhost:5173
# Local Postgres from `pnpm db:up` (local placeholder credentials)
DATABASE_URL=postgres://vento:vento@localhost:5432/vento
# Separate database used by `pnpm test`
TEST_DATABASE_URL=postgres://vento:vento@localhost:5432/vento_test
# debug | info | warn | error
LOG_LEVEL=info
