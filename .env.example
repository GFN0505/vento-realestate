# Copy to .env and adjust. Never commit .env (the repo is public).

# API
PORT=3000
# Where the web app runs, for CORS and links in emails
WEB_ORIGIN=http://localhost:5173
# Local Postgres from `pnpm db:up` (local placeholder credentials)
DATABASE_URL=postgres://vento:vento@localhost:5432/vento
# Separate database used by `pnpm test`
TEST_DATABASE_URL=postgres://vento:vento@localhost:5432/vento_test
# Browser tests (pnpm e2e) use their own database; created automatically if missing
E2E_DATABASE_URL=postgres://vento:vento@localhost:5432/vento_e2e
# debug | info | warn | error
LOG_LEVEL=info

# Auth (Better Auth). Signing secret, 32+ random characters: openssl rand -base64 32
# Never commit a real one.
BETTER_AUTH_SECRET=
# Email: dev = print to the console and save files in EMAIL_DEV_DIR; memory = tests only.
# Production refuses to start until a real provider is configured.
EMAIL_TRANSPORT=dev
EMAIL_FROM="Vento Real Estate <no-reply@localhost>"
EMAIL_DEV_DIR=.mail
# on | off. Per-IP request limits on sign-in, sign-up, reset and invitation links. Off only in
# CI/e2e. Account lockouts (10 wrong passwords, 5 wrong codes) always apply.
AUTH_RATE_LIMIT=on
# Header holding the client IP behind a trusted proxy (e.g. x-forwarded-for). Empty = socket address.
TRUSTED_IP_HEADER=
# Password for the seeded demo users (pnpm db:seed, development only). Pick your own.
SEED_PASSWORD=
# Feature flags and plans. Seconds between reloads of the in-memory availability snapshot (1-30).
FEATURE_SNAPSHOT_REFRESH_SECONDS=10
# "Talk to Vento" for organization owners. Required in production. WhatsApp is optional, E.164
# (e.g. +2348012345678); when set, Talk to Vento opens WhatsApp instead of email.
SUPPORT_EMAIL=
SUPPORT_WHATSAPP=
# Host-only, for the flag and plan commands (not read by the API). VENTO_OPERATOR: the person
# using this shell, recorded in the platform audit trail. VENTO_CRON=1: set only in the scheduler
# that runs `plans notify-trials`, which then needs no --by.
# VENTO_OPERATOR=
# VENTO_CRON=
