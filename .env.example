# Copy to .env and adjust. Never commit .env (the repo is public).

# API
PORT=3000
# Where the web app runs, for CORS and links in emails. Also the passkey domain (decision 0019):
# use localhost, never 127.0.0.1 (an IP address can't hold passkeys). https:// in production.
WEB_ORIGIN=http://localhost:5173
# Local Postgres from `pnpm db:up` (local placeholder credentials)
DATABASE_URL=postgres://vento:vento@localhost:5432/vento
# Separate database used by `pnpm test`
TEST_DATABASE_URL=postgres://vento:vento@localhost:5432/vento_test
# Browser tests (pnpm e2e) use their own database; created automatically if missing
E2E_DATABASE_URL=postgres://vento:vento@localhost:5432/vento_e2e
# debug | info | warn | error
LOG_LEVEL=info

# Auth (Better Auth). Signing secret, 32+ random characters: openssl rand -base64 32
# Never commit a real one.
BETTER_AUTH_SECRET=
# development | staging | production (empty = development). Staging and production need
# Postmark; staging also needs the allow-list. NODE_ENV=production requires it to be set.
APP_ENV=development
# Email: dev = print to the console and save files in EMAIL_DEV_DIR (pruned to 7 days / newest
# 500 at API start); memory = tests only; postmark = real email. Postmark is refused in tests, CI
# and e2e. In development it's allowed for manual testing in the browser, but only with
# POSTMARK_SERVER_TOKEN and EMAIL_ALLOWED_RECIPIENTS set; anyone not listed still goes to .mail/.
EMAIL_TRANSPORT=dev
# Staging/production: "Vento Real Estate <no-reply@mail.{Vento domain}>" (a verified Postmark
# sender). Development with Postmark: any address on your verified Postmark domain.
EMAIL_FROM="Vento Real Estate <no-reply@localhost>"
EMAIL_DEV_DIR=.mail
# Postmark server API token (one per server: staging, production). From the secrets store only.
POSTMARK_SERVER_TOKEN=
# Default transactional stream
POSTMARK_MESSAGE_STREAM=outbound
# 32+ random characters (openssl rand -hex 32); the Basic-auth password in the bounce webhook URL.
# Required on staging and production; the webhook route exists only when it's set.
POSTMARK_WEBHOOK_SECRET=
# Who may get real email: comma-separated domains and addresses, e.g.
# you@example.com,@your-test-domain.com. No wildcards or spaces; seed domains (ventohomes.ng,
# lekkipartners.ng) are refused. Required on staging and for Postmark in development; must be
# empty in production.
EMAIL_ALLOWED_RECIPIENTS=
# on | off. Per-IP request limits on sign-in, sign-up, reset and invitation links. Off only in
# CI/e2e. Account lockouts (10 wrong passwords, 5 wrong codes) always apply.
AUTH_RATE_LIMIT=on
# Header holding the client IP behind a trusted proxy (e.g. x-forwarded-for). Empty = socket address.
TRUSTED_IP_HEADER=
# Password for the seeded demo users (pnpm db:seed, development only). Pick your own.
SEED_PASSWORD=
# Approximate places on My security (decision 0020): path to DB-IP "IP to City Lite" (MMDB,
# CC BY 4.0, https://db-ip.com/db/download/ip-to-city-lite), refreshed monthly. Never commit the
# file. Empty = no places shown; sign-in works the same.
GEOIP_DB_PATH=
# Feature flags and plans. Seconds between reloads of the in-memory availability snapshot (1-30).
FEATURE_SNAPSHOT_REFRESH_SECONDS=10
# "Talk to Vento" for organization owners. Required in production. WhatsApp is optional, E.164
# (e.g. +2348012345678); when set, Talk to Vento opens WhatsApp instead of email.
SUPPORT_EMAIL=
SUPPORT_WHATSAPP=
# Host-only, for the flag and plan commands (not read by the API). VENTO_OPERATOR: the person
# using this shell, recorded in the platform audit trail. VENTO_CRON=1: set only in the scheduler
# that runs `plans notify-trials`, which then needs no --by.
# VENTO_OPERATOR=
# VENTO_CRON=
# Set by the harnesses, never in .env: CI (GitHub Actions) and VENTO_E2E=1 (Playwright) make the
# API refuse Postmark. VENTO_EMAIL_INTEGRATION=1 with POSTMARK_SERVER_TOKEN=POSTMARK_API_TEST runs
# the opt-in `pnpm --filter @vento/api email:check`.
