# Copy to .env and adjust. Never commit .env (the repo is public).

# API
PORT=3000
# Where the web app runs, for CORS and links in emails. Also the passkey domain (decision 0019):
# use localhost, never 127.0.0.1 (an IP address can't hold passkeys). https:// in production:
# WEB_ORIGIN=https://realestate.ventoerp.com (the console is realestate.ventoerp.com/console).
WEB_ORIGIN=http://localhost:5173
# Local Postgres from `pnpm db:up` (local placeholder credentials)
DATABASE_URL=postgres://vento:vento@localhost:5432/vento
# Separate database used by `pnpm test`
TEST_DATABASE_URL=postgres://vento:vento@localhost:5432/vento_test
# Browser tests (pnpm e2e) use their own database; created automatically if missing
E2E_DATABASE_URL=postgres://vento:vento@localhost:5432/vento_e2e
# debug | info | warn | error
LOG_LEVEL=info

# Auth (Better Auth). Signing secret, 32+ random characters: openssl rand -base64 32
# Never commit a real one.
BETTER_AUTH_SECRET=
# Email: dev = print to the console and save files in EMAIL_DEV_DIR; memory = tests only.
# Production refuses to start until a real provider is configured.
EMAIL_TRANSPORT=dev
# Production: "Vento Real Estate <no-reply@realestate.ventoerp.com>", with the sender signature,
# DKIM and Return-Path set up on that domain.
EMAIL_FROM="Vento Real Estate <no-reply@localhost>"
EMAIL_DEV_DIR=.mail
# on | off. Per-IP request limits on sign-in, sign-up, reset and invitation links. Off only in
# CI/e2e. Account lockouts (10 wrong passwords, 5 wrong codes) always apply.
AUTH_RATE_LIMIT=on
# Header holding the client IP behind a trusted proxy (e.g. x-forwarded-for). Empty = socket address.
TRUSTED_IP_HEADER=
# Password for the seeded demo users (pnpm db:seed, development only). Pick your own.
SEED_PASSWORD=
# Approximate places on My security (decision 0020): path to DB-IP "IP to City Lite" (MMDB,
# CC BY 4.0, https://db-ip.com/db/download/ip-to-city-lite), refreshed monthly. Never commit the
# file. Empty = no places shown; sign-in works the same.
GEOIP_DB_PATH=
# Feature flags and plans. Seconds between reloads of the in-memory availability snapshot (1-30).
FEATURE_SNAPSHOT_REFRESH_SECONDS=10
# "Talk to Vento Real Estate" for organization owners: a Vento Real Estate support address.
# Required in production. WhatsApp is optional, E.164 (e.g. +2348012345678); when set, Talk to
# Vento Real Estate opens WhatsApp instead of email.
SUPPORT_EMAIL=
SUPPORT_WHATSAPP=
# Vento Real Estate's security inbox: told about a break-glass change when there's no other super-admin to
# tell. Optional; without it that case is only logged (set it in production).
SECURITY_ALERT_EMAIL=
# Private file storage (decision 0025). s3 = any S3-compatible bucket; memory = tests only (the API
# refuses it in production). The values below match the local container from `pnpm db:up`
# (local placeholders, not secrets); unset S3_* values fall back to them outside production.
# Production (Cloudflare R2, EU jurisdiction): S3_ENDPOINT=https://<account-id>.eu.r2.cloudflarestorage.com,
# S3_REGION=auto, S3_BUCKET, and an API token's key pair scoped to that bucket. AWS S3: leave
# S3_ENDPOINT empty and set S3_REGION=af-south-1. Setting S3_ENDPOINT also runs the storage
# contract test (apps/api/src/storage/storage.s3.test.ts) in `pnpm test`.
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=vento-local
S3_ACCESS_KEY_ID=vento
S3_SECRET_ACCESS_KEY=vento-local-secret
# true for MinIO and most S3-compatible stores; R2 and AWS work either way.
S3_FORCE_PATH_STYLE=true
# Host-only, for the flag and plan commands (not read by the API). VENTO_OPERATOR: the person
# using this shell, recorded in the platform audit trail. VENTO_CRON=1: set only in the scheduler
# that runs `plans notify-trials`, `approvals expire` and `files sweep`, which then need no --by.
# VENTO_OPERATOR=
# VENTO_CRON=
