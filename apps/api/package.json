    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "@orpc/server": "^1.16.5",
    "@vento/shared": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.21",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.15",
    "vitest": "^5.1.1"
  }
}
