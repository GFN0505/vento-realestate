{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": [".env"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^typecheck"],
      "env": ["DATABASE_URL", "TEST_DATABASE_URL"],
      "passThroughEnv": [
        "PORT",
        "WEB_ORIGIN",
        "LOG_LEVEL",
        "TEST_LOG_LEVEL",
        "CI",
        "BETTER_AUTH_SECRET",
        "EMAIL_TRANSPORT",
        "EMAIL_FROM",
        "EMAIL_DEV_DIR",
        "AUTH_RATE_LIMIT",
        "PWNED_PASSWORDS_CHECK",
        "TRUSTED_IP_HEADER"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "VITE_API_PROXY",
        "PORT",
        "WEB_ORIGIN",
        "DATABASE_URL",
        "LOG_LEVEL",
        "BETTER_AUTH_SECRET",
        "EMAIL_TRANSPORT",
        "EMAIL_FROM",
        "EMAIL_DEV_DIR",
        "AUTH_RATE_LIMIT",
        "PWNED_PASSWORDS_CHECK",
        "TRUSTED_IP_HEADER"
      ]
    }
  }
}
